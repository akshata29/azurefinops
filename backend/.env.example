# --- Backend configuration -------------------------------------------------
# Copy to .env and adjust. Demo mode (USE_MOCK=true) needs no Azure access.

USE_MOCK=true

# Central store the dashboard reads from when USE_MOCK=false ("adx" or "storage")
DATA_BACKEND=adx

# Azure AD multi-tenant app (client credentials) used for MACC pulls
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure Data Explorer (when DATA_BACKEND=adx)
ADX_CLUSTER_URI=
ADX_DATABASE=Hub

# CORS origins for the frontend dev server
CORS_ORIGINS=http://localhost:5174,http://localhost:4173,http://localhost:5173
