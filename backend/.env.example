# --- Backend configuration -------------------------------------------------
# Copy to .env and adjust. Demo mode (USE_MOCK=true) needs no Azure access.

# Toggle: true = synthetic demo data, false = real Azure Cost Management data.
USE_MOCK=true

# Live data source when USE_MOCK=false:
#   azure   = query Azure Cost Management directly (no FinOps hub needed)  <-- default
#   adx     = read a central FinOps-hub Azure Data Explorer cluster
#   storage = read exported FOCUS parquet from ADLS
DATA_BACKEND=azure

# --- Auth (USE_MOCK=false) -------------------------------------------------
# Leave client id/secret blank to use DefaultAzureCredential (az login /
# managed identity / environment). Set all three for an app registration.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Subscriptions to treat as affiliates (comma-separated). Blank = auto-discover
# every subscription the signed-in identity can read.
AZURE_SUBSCRIPTION_IDS=

# Path to an affiliate registry JSON that maps affiliates -> tenants/subscriptions
# (the scale primitive for onboarding). Blank = auto-detect ./affiliates.json,
# else fall back to subscription auto-discovery. See affiliates.example.json.
AFFILIATE_REGISTRY=

# How many months of history to pull (Cost Management retains ~13 months).
HISTORY_MONTHS=13

# Optional JSON overriding license list prices by skuPartNumber, e.g.
#   { "SPE_E5": { "name": "Microsoft 365 E5", "unit_cost": 54.0 }, "POWER_BI_PRO": 8.5 }
# Blank = use built-in list-price estimates.
LICENSE_PRICE_MAP=

# --- GitHub Copilot (external seats for the AI slice) ----------------------
# Token needs manage_billing:copilot (or read:org + Copilot). Orgs can also be
# set per-affiliate in the registry ("github_orgs": [...]).
GITHUB_TOKEN=
GITHUB_ORGS=
GITHUB_COPILOT_SEAT_COST=39.0
M365_COPILOT_SEAT_COST=30.0

# Cache TTL (seconds) for Cost Management queries — they are heavily throttled.
CACHE_TTL_SECONDS=3600

# Azure Data Explorer (only when DATA_BACKEND=adx)
ADX_CLUSTER_URI=
ADX_DATABASE=Hub

# CORS origins for the frontend dev server
CORS_ORIGINS=http://localhost:5174,http://localhost:4173,http://localhost:5173
